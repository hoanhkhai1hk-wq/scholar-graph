# Copy to ignored .env. Docker Compose reads this file; host shells do not auto-load it.
# Secrets stay on the backend. Empty key => translation/generation return an honest error.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
SCHOLAR_GRAPH_QA_MODE=deepseek

# Compose host ports (container-to-container backend remains backend:8000).
SCHOLAR_GRAPH_FRONTEND_PORT=3000
SCHOLAR_GRAPH_BACKEND_PORT=8000
SCHOLAR_GRAPH_BACKEND_IMAGE=scholar-graph-backend:local
SCHOLAR_GRAPH_FRONTEND_IMAGE=scholar-graph-frontend:local
SCHOLAR_GRAPH_REVISION=unknown

# Optional host/developer settings. Compose owns /app/data via its named volume.
SCHOLAR_GRAPH_DATA_DIR=data/workbench-personal
SCHOLAR_GRAPH_WORKSPACE_RETRIEVAL=lexical
SCHOLAR_GRAPH_QA_RETRIEVAL_MODE=hybrid
SCHOLAR_GRAPH_RETRIEVAL_MODE=lexical
SCHOLAR_GRAPH_QA_RERANKER=rrf
SCHOLAR_GRAPH_VECTOR_RESIDENT=true
# Optional BGE-M3 weights/runtime: configure only after reviewing licenses.
# SCHOLAR_GRAPH_BGE_M3_PATH=data/module-four-models/bge-m3
# SCHOLAR_GRAPH_VECTOR_PYTHON=backend/.vector-venv/Scripts/python.exe
GROBID_URL=http://127.0.0.1:8070
SCHOLAR_GRAPH_GROBID_ENABLED=true
SCHOLAR_GRAPH_OCR_CACHE_DIR=data/paddle-models
SCHOLAR_GRAPH_TRACKING_ENABLED=false
SG_BACKEND_URL=http://127.0.0.1:8020
SG_BUILD_DIR=.next-workbench

# Optional public review mode. Generate new random secrets at deployment time.
# The public backend must not be exposed directly. These entries are not accounts.
SG_REVIEW_CODE=
SG_REVIEW_SIGNING_KEY=
SG_SERVICE_TOKEN=
SG_DEMO_MODE=false
SG_DATA_CLASS=personal
SG_PUBLIC_ORIGIN=http://127.0.0.1:3300
SG_SECURE_COOKIE=false
SG_DEMO_STORAGE_LIMIT_BYTES=2147483648
