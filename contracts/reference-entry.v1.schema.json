{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scholar-graph:contract:reference-entry:1.0.0",
  "title": "ReferenceEntry",
  "description": "ReferenceEntry contract v1.0.0; see CONTRACTS.md for semantic constraints.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "ref_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "paper_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "year": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 9999
    },
    "title": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "venue": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "doi": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "arxiv_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "ref_id",
    "paper_id",
    "number",
    "authors",
    "year",
    "title",
    "venue",
    "doi",
    "arxiv_id"
  ],
  "additionalProperties": false
}
