{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scholar-graph:contract:qa-answer:1.0.0",
  "title": "QAAnswer",
  "description": "QAAnswer contract v1.0.0; see CONTRACTS.md for semantic constraints.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "paper_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "page_number": {
            "type": "integer",
            "minimum": 1
          },
          "section": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "chunk_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "required": [
          "paper_id",
          "page_number",
          "section",
          "chunk_id"
        ],
        "additionalProperties": false
      }
    },
    "numeric_fact_check": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "unverifiable",
            "not_applicable"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "unverifiable"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "paper_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "page_number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "section": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "chunk_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    }
                  },
                  "required": [
                    "paper_id",
                    "page_number",
                    "section",
                    "chunk_id"
                  ],
                  "additionalProperties": false
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "claim",
              "status",
              "evidence",
              "reason"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "passed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "evidence": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "required": [
        "status",
        "checks"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "checks": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "items": {
                  "properties": {
                    "status": {
                      "const": "passed"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "failed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unverifiable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "unverifiable"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "items": {
                  "properties": {
                    "status": {
                      "enum": [
                        "passed",
                        "unverifiable"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "refused": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "answer",
    "anchors",
    "numeric_fact_check",
    "refused"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "refused": {
            "const": false
          }
        },
        "required": [
          "refused"
        ]
      },
      "then": {
        "properties": {
          "anchors": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
