{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scholar-graph:contract:framework-outline:1.2.0",
  "title": "FrameworkOutline",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.2.0"
    },
    "paper_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "chapter_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "cornerstone",
              "derived",
              "isolated",
              "future_work"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "paper_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          },
          "anchors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/chunk_anchor"
            }
          },
          "writing_points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 600
                },
                "anchor": {
                  "$ref": "#/$defs/chunk_anchor"
                }
              },
              "required": [
                "text",
                "anchor"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "chapter_id",
          "kind",
          "title",
          "paper_ids",
          "anchors",
          "writing_points"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "paper_ids",
    "chapters"
  ],
  "additionalProperties": false,
  "$defs": {
    "chunk_anchor": {
      "type": "object",
      "properties": {
        "paper_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "chunk_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "paper_id",
        "page_number",
        "section",
        "chunk_id"
      ],
      "additionalProperties": false
    }
  }
}
