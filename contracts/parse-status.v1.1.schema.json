{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scholar-graph:contract:parse-status:1.1.0",
  "title": "ParseStatus",
  "description": "ParseStatus contract v1.1.0. The shared HTTP error envelope is exported at #/$defs/api_error, not a fifth business record.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1.0"
    },
    "paper_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "parsing",
        "ocr",
        "indexing",
        "completed",
        "failed"
      ]
    },
    "progress": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "current_stage": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "error_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/error_code"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "paper_id",
    "status",
    "progress",
    "current_stage",
    "error_code",
    "error_message"
  ],
  "additionalProperties": false,
  "$defs": {
    "error_code": {
      "type": "string",
      "enum": [
        "VALIDATION_ERROR",
        "PAPER_NOT_FOUND",
        "UNSUPPORTED_FILE_TYPE",
        "FILE_TOO_LARGE",
        "PARSE_FAILED",
        "OCR_FAILED",
        "INDEXING_FAILED",
        "CSV_INVALID",
        "CHART_VALIDATION_FAILED",
        "UPSTREAM_ERROR",
        "INTERNAL_ERROR"
      ]
    },
    "api_error": {
      "type": "object",
      "properties": {
        "error_code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "details": {
          "anyOf": [
            {
              "type": "object",
              "properties": {},
              "required": [],
              "patternProperties": {
                "^[a-z][a-z0-9_]*$": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              },
              "additionalProperties": false,
              "description": "Optional diagnostic information represented by null when absent. Scalar diagnostics only; no arrays or nested business records."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "error_code",
        "message",
        "details"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error_code": {
            "$ref": "#/$defs/error_code"
          },
          "error_message": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "progress": {
            "maximum": 99
          }
        }
      },
      "else": {
        "properties": {
          "error_code": {
            "type": "null"
          },
          "error_message": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "progress": {
            "const": 100
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "queued"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "progress": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "parsing",
              "ocr",
              "indexing"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "progress": {
            "maximum": 99
          }
        }
      }
    }
  ]
}
